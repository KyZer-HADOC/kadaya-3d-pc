
#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:DesktopGL
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#


#---------------------------------- Content ---------------------------------#

#begin Font.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Color
/build:Font.spritefont

#begin Audio/MainMenu_Music.mp3
/importer:Mp3Importer
/processor:SongProcessor
/build:Audio/MainMenu_Music.mp3

#begin Audio/Reaper_Scythe_Attack.wav
/importer:WavImporter
/processor:SoundEffectProcessor
/build:Audio/Reaper_Scythe_Attack.wav

#begin Audio/Reaper_Transformation.mp3
/importer:Mp3Importer
/processor:SongProcessor
/build:Audio/Reaper_Transformation.mp3

